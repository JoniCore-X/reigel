# Configuración local: sin claves ni API de pago.
REIGEL_ENV=local
# Por defecto: %LOCALAPPDATA%/PowerSolar/reigel.db, fuera de OneDrive.
# REIGEL_DB_PATH=C:/Users/tu_usuario/AppData/Local/PowerSolar/reigel.db
REIGEL_LOCAL_MODEL=qwen2.5:3b
# Ollama debe estar instalado con este modelo LOCAL. No se descargan modelos.
# Se usa exclusivamente http://127.0.0.1:11434 y se rechazan alias cloud.
SITE_URL=
REIGEL_ALLOWED_HOSTS=

# Telegram opcional. No se configura ni se usa para el chat web propio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta/OpenAI no se activan: envíos Meta bloqueados por política de costo;
# las antiguas claves OpenAI no se utilizan.

# Sólo para un despliegue HTTPS solicitado por separado.
DOMAIN=
CADDY_EMAIL=
