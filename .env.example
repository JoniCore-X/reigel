# Plantilla de configuración de R.E.I.G.E.L. Copiar a «.env» y completar allí.
# «.env» nunca se sube al repositorio (el repositorio es público) ni entra en la
# imagen de Docker. Este archivo de ejemplo no debe llevar valores reales:
# ni dominios, ni correos, ni claves.

# ───────────── Uso local en la computadora (scripts/start.ps1) ─────────────
# Sin claves ni API de pago.
REIGEL_ENV=local
# Por defecto: %LOCALAPPDATA%/PowerSolar/reigel.db, fuera de OneDrive.
# REIGEL_DB_PATH=C:/Users/tu_usuario/AppData/Local/PowerSolar/reigel.db

# ───────────── Servidor con Docker (docs/DESPLIEGUE.md) ─────────────
# compose.yaml fija por su cuenta REIGEL_ENV=production,
# REIGEL_DB_PATH=/app/data/reigel.db y SITE_URL=https://DOMAIN; en el servidor
# no hace falta escribir esas tres. Sí son obligatorias DOMAIN y CADDY_EMAIL.
# Dominio público sin «https://» ni rutas (forma: reigel.ejemplo.com).
DOMAIN=
# Correo para los avisos del certificado HTTPS (forma: persona@ejemplo.com).
CADDY_EMAIL=
# Fuera de Docker, producción exige la dirección pública completa con https://.
SITE_URL=
# Nombres de servidor adicionales aceptados, separados por comas. Normalmente
# vacío: el dominio de SITE_URL ya se acepta.
REIGEL_ALLOWED_HOSTS=
# Límites de la aplicación en Docker. Vacío: 768m de memoria y 1.0 CPU.
# REIGEL_APP_MEMORY=
# REIGEL_APP_CPUS=

# ───────────── Acceso del equipo ─────────────
# Clave AES de 32 bytes en base64url para los secretos de Google Authenticator.
# Vacía (recomendado): se crea el archivo <base>.totp.key junto a la base
# (en Docker, /app/data/reigel.db.totp.key dentro del volumen de datos).
# Si se define, hay que conservarla aparte: sin ella nadie entra con su código.
REIGEL_TOTP_KEY=

# Correos autorizados del equipo, separados por comas (forma: ana.powersolar@example.com).
# Solo añade al arrancar; nunca quita. El propietario gestiona la lista en /app.
# Vacía: solo el correo del propietario queda autorizado automáticamente.
REIGEL_TEAM_ALLOWED_EMAILS=

# ───────────── IA local (Ollama) ─────────────
# Vacío: sin IA; el sitio, /chat con reglas propias y /app siguen funcionando.
# «ollama» la activa. Sus respuestas en /, /ia y /chat se publican sin revisión
# humana, solo con validadores de patrones.
REIGEL_CHAT_AI=
# En Docker, además, encender el contenedor de Ollama: COMPOSE_PROFILES=ia
# (descarga la imagen de Ollama; el titular debe autorizarla).
COMPOSE_PROFILES=
# Modelo LOCAL ya instalado en Ollama. No se descargan modelos automáticamente.
# Se usa exclusivamente http://127.0.0.1:11434 y se rechazan alias cloud.
REIGEL_LOCAL_MODEL=qwen2.5:3b
# Modelo de /, /ia y /chat. Vacío: usa REIGEL_LOCAL_MODEL.
# REIGEL_CHAT_MODEL=
REIGEL_LOCAL_TIMEOUT_SECONDS=35
REIGEL_LOCAL_NUM_CTX=2048
REIGEL_LOCAL_NUM_PREDICT=260
REIGEL_LOCAL_TEMPERATURE=0.15
# Límites permitidos: timeout 10–120 s, contexto 512–8192,
# predicción 64–512 tokens y temperatura 0–0.4.
# Límites del contenedor de Ollama en Docker. Vacío: 5g de memoria y 2.0 CPU.
# OLLAMA_MEMORY=
# OLLAMA_CPUS=
# OLLAMA_KEEP_ALIVE=

# ───────────── Canales externos (opcionales, apagados) ─────────────
# Telegram opcional. No se configura ni se usa para el chat web propio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta/OpenAI no se activan: envíos Meta bloqueados por política de costo;
# las antiguas claves OpenAI no se utilizan.

# R.E.I.G.E.L. Identity: cada proveedor queda deshabilitado hasta tener ambos valores.
REIGEL_OAUTH_GOOGLE_CLIENT_ID=
REIGEL_OAUTH_GOOGLE_CLIENT_SECRET=
REIGEL_OAUTH_FACEBOOK_CLIENT_ID=
REIGEL_OAUTH_FACEBOOK_CLIENT_SECRET=
REIGEL_OAUTH_X_CLIENT_ID=
REIGEL_OAUTH_X_CLIENT_SECRET=
REIGEL_OAUTH_TIKTOK_CLIENT_ID=
REIGEL_OAUTH_TIKTOK_CLIENT_SECRET=
